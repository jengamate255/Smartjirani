# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# PesaPal Payment Configuration (https://developer.pesapal.com)
PESAPAL_CONSUMER_KEY=your-consumer-key
PESAPAL_CONSUMER_SECRET=your-consumer-secret
PESAPAL_ENV=sandbox
PESAPAL_CALLBACK_URL=https://your-app.com/pesapal/callback

# Mapbox Configuration
MAPBOX_DOWNLOADS_TOKEN=your-mapbox-downloads-token
MAPBOX_ACCESS_TOKEN=your-mapbox-public-access-token

# LiveKit Configuration (for edge functions)
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=https://your-livekit-instance.livekit.cloud
